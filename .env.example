# Copy to .env and fill in from the Nexconn Console (Key Management page).
# Never commit .env. Never paste these into chat.
# Leave VITE_NEXCONN_APP_KEY empty to run the offline mock (works across browser tabs).
VITE_NEXCONN_APP_KEY=
# SG for Singapore (Jude's 'First application' is Singapore), NA for North America. Must match the app's data center.
VITE_NEXCONN_AREA=SG
# Server-only values (used by /api functions; never shipped to the browser).
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# api.sg-light-api.com (Singapore) or api.us-light-api.com (North America).
NEXCONN_API_HOST=api.sg-light-api.com
